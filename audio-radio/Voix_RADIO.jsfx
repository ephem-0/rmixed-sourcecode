desc:Voix RADIO - Dense et grave
// Causal voice processor. No lookahead or FFT. Input must be mono on channels 1/2.
slider1:8<-12,24,0.1>Gain entree (dB)
slider2:-46<-70,-25,1>Seuil expandeur apres EQ (dB)
slider3:-25<-40,-8,0.5>Seuil compresseur (dB)
slider4:3.5<1,8,0.1>Ratio compression
slider5:12<-12,20,0.1>Gain sortie (dB)
slider6:2<-2,5,0.1>Corps 125 Hz (dB)
slider7:3<0,6,0.1>Presence 2800 Hz (dB)
slider8:-37<-55,-15,0.5>Seuil de-esser (dB)
in_pin:Mono L
in_pin:Mono R
out_pin:L
out_pin:R
@init
function db(v) (20*log(max(v,0.0000000001))/log(10););
function gain(v) (10^(v/20););
function follow(cur,t,att,rel) local(k) (k=exp(-1/(srate*(t>cur?att:rel))); k*cur+(1-k)*t;);
function setup(p,kind,f,g,q) local(w,c,s,al,A,t,b0,b1,b2,a0,a1,a2) (
 w=2*$pi*f/srate;c=cos(w);s=sin(w);al=s/(2*q);A=10^(g/40);
 kind==0 ? (b0=(1+c)/2;b1=-(1+c);b2=b0;a0=1+al;a1=-2*c;a2=1-al;);
 kind==1 ? (b0=1+al*A;b1=-2*c;b2=1-al*A;a0=1+al/A;a1=-2*c;a2=1-al/A;);
 kind>=2 ? (
 al=s/2*sqrt(2);t=2*sqrt(A)*al;
 kind==2 ? (b0=A*((A+1)-(A-1)*c+t);b1=2*A*((A-1)-(A+1)*c);b2=A*((A+1)-(A-1)*c-t);a0=(A+1)+(A-1)*c+t;a1=-2*((A-1)+(A+1)*c);a2=(A+1)+(A-1)*c-t;) :
 (b0=A*((A+1)+(A-1)*c+t);b1=-2*A*((A-1)+(A+1)*c);b2=A*((A+1)+(A-1)*c-t);a0=(A+1)-(A-1)*c+t;a1=2*((A-1)-(A+1)*c);a2=(A+1)-(A-1)*c-t;);
 );p[0]=b0/a0;p[1]=b1/a0;p[2]=b2/a0;p[3]=a1/a0;p[4]=a2/a0;
);
function filt(p,v) local(y) (y=p[0]*v+p[5];p[5]=p[1]*v-p[3]*y+p[6];p[6]=p[2]*v-p[4]*y;y;);
ge=ce=de=lp=0;gg=1;
@slider
setup(0,0,65,0,.707);setup(10,2,125,slider6,.707);setup(20,1,330,-3,1);setup(30,1,2800,slider7,.8);setup(40,3,8000,1.5,.707);
inputgain=gain(slider1);outputgain=gain(slider5);cross=exp(-2*$pi*4800/srate);
@sample
v=(spl0+spl1)*.5*inputgain;
v=filt(0,v);v=filt(10,v);v=filt(20,v);v=filt(30,v);v=filt(40,v);
ge=follow(ge,abs(v),.003,.16);gd=db(ge);target=gain(max(-12,min(0,(gd-slider2)*.6)));
k=exp(-1/(srate*(target>gg?.003:.14)));gg=k*gg+(1-k)*target;v*=gg;
ce=follow(ce,abs(v),.005,.10);over=db(ce)-slider3;
red=over < -3 ? 0 : over < 3 ? (1-1/slider4)*(over+3)^2/12 : (1-1/slider4)*over;
v*=gain(-red);
lp=cross*lp+(1-cross)*v;hi=v-lp;de=follow(de,abs(hi),.0005,.055);dr=min(5,max(0,(db(de)-slider8)*.65));v=lp+hi*gain(-dr);
v*=outputgain;spl0=spl1=max(-.891250938,min(.891250938,v));
